#version 450
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// Average colour of one material's albedo and emissive maps, for the GI rays (they have no texture coordinates).
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants
{
    vec4 Colour;   // material albedo colour, w = how much of the map to use
    vec4 Emissive; // emissive colour x intensity, w = 1 when the emissive map is its colour
    uint Index;
    float Lod;
    float EmissiveLod;
    float _pad0;
} pc;

layout(set = 0, binding = 0) uniform sampler2D u_Albedo;
layout(std430, set = 0, binding = 1) buffer Materials { vec4 data[]; } u_Materials; // albedo, emissive per material
layout(set = 0, binding = 2) uniform sampler2D u_Emissive;

shared vec3 s_Sum[64];
shared vec3 s_SumE[64];

void main()
{
    uint i  = gl_LocalInvocationID.x;
    vec2 uv = (vec2(i % 8u, i / 8u) + 0.5) / 8.0;
    vec3 c  = textureLod(u_Albedo, uv, pc.Lod).rgb;
    s_Sum[i] = pow(max(c, vec3(0.0)), vec3(2.2)); // the maps are sRGB, read raw like the forward shader does
    vec3 e   = textureLod(u_Emissive, uv, pc.EmissiveLod).rgb;
    s_SumE[i] = pow(max(e, vec3(0.0)), vec3(2.2));
    barrier();

    for(uint stride = 32u; stride > 0u; stride >>= 1u)
    {
        if(i < stride)
        {
            s_Sum[i] += s_Sum[i + stride];
            s_SumE[i] += s_SumE[i + stride];
        }
        barrier();
    }

    if(i == 0u)
    {
        vec3 albedo = pc.Colour.rgb * mix(vec3(1.0), s_Sum[0] / 64.0, pc.Colour.w);
        // as GetEmissive in ForwardPBR.frag: the map is its own colour, a bare colour glows in the albedo's tint
        vec3 emissive = pc.Emissive.rgb * (pc.Emissive.w > 0.5 ? s_SumE[0] / 64.0 : albedo);
        u_Materials.data[pc.Index * 2u]      = vec4(albedo, 1.0);
        u_Materials.data[pc.Index * 2u + 1u] = vec4(emissive, 0.0);
    }
}
