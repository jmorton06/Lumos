#version 450
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// Builds a 256-bin log-luminance histogram from the HDR scene texture.
// Bin index 0 is reserved for ~black pixels; bins 1..255 map linearly across
// [u_Params.MinLogLum, u_Params.MaxLogLum] in log2 space.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_HDRTexture;

layout(std430, set = 0, binding = 1) buffer HistogramBuffer
{
    uint Histogram[256];
} u_Hist;

layout(push_constant) uniform Uniforms
{
    float MinLogLum;
    float InvLogLumRange;   // 1.0 / (MaxLogLum - MinLogLum)
    uint  TexWidth;
    uint  TexHeight;
} u_Params;

shared uint s_LocalHistogram[256];

uint LuminanceToBin(vec3 colour)
{
    float lum = dot(colour, vec3(0.2125, 0.7154, 0.0721));
    if(lum < 0.005)
        return 0;
    float logLum = clamp((log2(lum) - u_Params.MinLogLum) * u_Params.InvLogLumRange, 0.0, 1.0);
    return uint(logLum * 254.0 + 1.0);
}

void main()
{
    s_LocalHistogram[gl_LocalInvocationIndex] = 0;
    barrier();

    uvec2 pos = gl_GlobalInvocationID.xy;
    if(pos.x < u_Params.TexWidth && pos.y < u_Params.TexHeight)
    {
        vec2 uv     = (vec2(pos) + 0.5) / vec2(u_Params.TexWidth, u_Params.TexHeight);
        vec3 colour = texture(u_HDRTexture, uv).rgb;
        uint bin    = LuminanceToBin(colour);
        atomicAdd(s_LocalHistogram[bin], 1);
    }
    barrier();

    atomicAdd(u_Hist.Histogram[gl_LocalInvocationIndex], s_LocalHistogram[gl_LocalInvocationIndex]);
}
