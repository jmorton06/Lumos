#version 450
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// One work group per grid cell: farthest depth in the cell's pixels.
// The CPU reads the grid a couple of frames later to cull occluded objects.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_Depth;

layout(std430, set = 0, binding = 1) buffer GridBuffer
{
    float Cells[];
} u_Grid;

layout(push_constant) uniform Uniforms
{
    uint TexWidth;
    uint TexHeight;
    uint GridX;
    uint GridY;
} u_Params;

shared float s_Max[64];

void main()
{
    uvec2 cell = gl_WorkGroupID.xy;
    uint x0 = (cell.x * u_Params.TexWidth) / u_Params.GridX;
    uint x1 = max(((cell.x + 1u) * u_Params.TexWidth) / u_Params.GridX, x0 + 1u);
    uint y0 = (cell.y * u_Params.TexHeight) / u_Params.GridY;
    uint y1 = max(((cell.y + 1u) * u_Params.TexHeight) / u_Params.GridY, y0 + 1u);
    x1 = min(x1, u_Params.TexWidth);
    y1 = min(y1, u_Params.TexHeight);

    float m = 0.0;
    for(uint y = y0 + gl_LocalInvocationID.y; y < y1; y += 8u)
        for(uint x = x0 + gl_LocalInvocationID.x; x < x1; x += 8u)
            m = max(m, 1.0 - texelFetch(u_Depth, ivec2(x, y), 0).r); // the CPU test works in standard depth (far = 1)

    uint i = gl_LocalInvocationIndex;
    s_Max[i] = m;
    barrier();
    for(uint s = 32u; s > 0u; s >>= 1u)
    {
        if(i < s)
            s_Max[i] = max(s_Max[i], s_Max[i + s]);
        barrier();
    }

    if(i == 0u)
        u_Grid.Cells[cell.y * u_Params.GridX + cell.x] = s_Max[0];
}
