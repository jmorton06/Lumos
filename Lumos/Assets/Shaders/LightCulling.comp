#version 450

#extension GL_ARB_separate_shader_objects : enable

#define TILE_SIZE 16
#define MAX_LIGHTS_PER_TILE 256

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE, local_size_z = 1) in;

struct Light
{
	vec4 colour;
	vec4 position;
	vec4 direction;
	float intensity;
	float radius;
	float type;
	float angle;
};

layout(set = 0, binding = 0) uniform sampler2D u_DepthTexture;

layout(std430, set = 0, binding = 1) readonly buffer LightBuffer {
	Light lights[];
} u_Lights;

layout(std430, set = 0, binding = 2) writeonly buffer LightGrid {
	uvec2 tiles[];
} u_LightGrid;

layout(std430, set = 0, binding = 3) writeonly buffer LightIndices {
	uint indices[];
} u_LightIndices;

layout(std430, set = 0, binding = 4) buffer GlobalIndexCount {
	uint globalCount;
} u_GlobalIndexCount;

layout(push_constant) uniform PushConstants
{
	mat4 invViewProj; // NDC -> world, so the tile volumes are built where the lights live
	uint screenWidth;
	uint screenHeight;
	uint tileCountX;
	uint tileCountY;
	uint lightCount;
	float hasDepth;   // 1 = the depth buffer holds this frame (pre-pass ran); 0 = whole depth range
	float pad0;
	float rangeMode;
} u_PushConstants;

shared uint s_MinDepth;
shared uint s_MaxDepth;
shared uint s_LightCount;
shared uint s_LightIndices[MAX_LIGHTS_PER_TILE];
shared uint s_GlobalOffset;

// world-space tile volume, normals pointing inwards
shared vec4 s_FrustumPlanes[6];

vec3 Unproject(vec2 pixel, float depth)
{
	// offscreen targets are not flipped: pixel row 0 is NDC y = -1
	vec2 ndc = pixel / vec2(u_PushConstants.screenWidth, u_PushConstants.screenHeight) * 2.0 - 1.0;
	vec4 p   = u_PushConstants.invViewProj * vec4(ndc, depth, 1.0);
	return p.xyz / p.w;
}

vec4 PlaneFrom(vec3 a, vec3 b, vec3 c, vec3 inside)
{
	vec3 n  = normalize(cross(b - a, c - a));
	vec4 pl = vec4(n, -dot(n, a));
	return dot(pl, vec4(inside, 1.0)) < 0.0 ? -pl : pl;
}

bool SphereInsideFrustum(vec3 center, float radius)
{
	for(int i = 0; i < 6; i++)
	{
		if(dot(vec4(center, 1.0), s_FrustumPlanes[i]) < -radius)
			return false;
	}
	return true;
}

void main()
{
	uvec2 tileID = gl_WorkGroupID.xy;
	uint tileIndex = tileID.y * u_PushConstants.tileCountX + tileID.x;
	uint localIndex = gl_LocalInvocationIndex;

	if(localIndex == 0)
	{
		s_MinDepth = 0xFFFFFFFF;
		s_MaxDepth = 0;
		s_LightCount = 0;
	}
	barrier();

	ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
	if(u_PushConstants.hasDepth > 0.5 && pixelCoord.x < int(u_PushConstants.screenWidth) && pixelCoord.y < int(u_PushConstants.screenHeight))
	{
		// depth is 0..1 and positive, so its bits sort like the floats
		float depth = texelFetch(u_DepthTexture, pixelCoord, 0).r;
		uint depthInt = floatBitsToUint(depth);
		atomicMin(s_MinDepth, depthInt);
		atomicMax(s_MaxDepth, depthInt);
	}
	barrier();

	if(localIndex == 0)
	{
		// reversed-Z: the largest depth in the tile is the nearest surface
		float nearDepth = 1.0;
		float farDepth  = 0.0;
		if(u_PushConstants.hasDepth > 0.5 && s_MinDepth <= s_MaxDepth)
		{
			nearDepth = uintBitsToFloat(s_MaxDepth);
			farDepth  = uintBitsToFloat(s_MinDepth);
		}

		vec2 tileMin = vec2(tileID) * float(TILE_SIZE);
		vec2 tileMax = min(tileMin + vec2(TILE_SIZE), vec2(u_PushConstants.screenWidth, u_PushConstants.screenHeight));
		vec2 tileMid = (tileMin + tileMax) * 0.5;

		vec3 n00 = Unproject(tileMin, 1.0);
		vec3 n10 = Unproject(vec2(tileMax.x, tileMin.y), 1.0);
		vec3 n01 = Unproject(vec2(tileMin.x, tileMax.y), 1.0);
		vec3 n11 = Unproject(tileMax, 1.0);
		vec3 f00 = Unproject(tileMin, 0.0);
		vec3 f10 = Unproject(vec2(tileMax.x, tileMin.y), 0.0);
		vec3 f01 = Unproject(vec2(tileMin.x, tileMax.y), 0.0);
		vec3 f11 = Unproject(tileMax, 0.0);

		vec3 nearMid = Unproject(tileMid, nearDepth);
		vec3 farMid  = Unproject(tileMid, farDepth);
		vec3 inside  = (nearMid + farMid) * 0.5;

		s_FrustumPlanes[0] = PlaneFrom(n00, f00, f01, inside); // left
		s_FrustumPlanes[1] = PlaneFrom(n10, f11, f10, inside); // right
		s_FrustumPlanes[2] = PlaneFrom(n00, f10, f00, inside); // top
		s_FrustumPlanes[3] = PlaneFrom(n01, f01, f11, inside); // bottom

		// depth bounds: planes facing along the view through the nearest and farthest surface
		// (depth is a function of distance along the camera's forward, so these are exact)
		vec2 screenMid = vec2(u_PushConstants.screenWidth, u_PushConstants.screenHeight) * 0.5;
		vec3 forward   = normalize(Unproject(screenMid, 0.0) - Unproject(screenMid, 1.0));
		s_FrustumPlanes[4] = vec4(forward, -dot(forward, nearMid));
		s_FrustumPlanes[5] = vec4(-forward, dot(forward, farMid));
	}
	barrier();

	// Each thread tests a subset of lights
	uint threadCount = TILE_SIZE * TILE_SIZE;
	for(uint i = localIndex; i < u_PushConstants.lightCount; i += threadCount)
	{
		Light light = u_Lights.lights[i];

		// Only cull point lights and spot lights (type 1 = spot, type 2 = point)
		if(light.type == 0.0)
		{
			// Directional light always visible
			uint idx = atomicAdd(s_LightCount, 1);
			if(idx < MAX_LIGHTS_PER_TILE)
				s_LightIndices[idx] = i;
		}
		else
		{
			// Sphere-frustum test using light position and radius
			vec3 lightPos = light.position.xyz;
			// a point light is zero past its radius; a spot is only bounded in range mode
			float lightRadius = (light.type == 2.0 || u_PushConstants.rangeMode > 0.5) ? light.radius : light.radius * 100.0;

			if(SphereInsideFrustum(lightPos, lightRadius))
			{
				uint idx = atomicAdd(s_LightCount, 1);
				if(idx < MAX_LIGHTS_PER_TILE)
					s_LightIndices[idx] = i;
			}
		}
	}
	barrier();

	// First thread writes results to global buffers
	if(localIndex == 0)
	{
		uint count = min(s_LightCount, uint(MAX_LIGHTS_PER_TILE));
		// a fixed slot per tile: a shared counter has to be zeroed between frames, and a frame
		// still in flight could be adding to it when the CPU did that
		s_GlobalOffset = tileIndex * uint(MAX_LIGHTS_PER_TILE);
		u_LightGrid.tiles[tileIndex] = uvec2(s_GlobalOffset, count);
	}
	barrier();

	// All threads cooperatively write light indices to global buffer
	uint count = min(s_LightCount, uint(MAX_LIGHTS_PER_TILE));
	for(uint i = localIndex; i < count; i += threadCount)
	{
		u_LightIndices.indices[s_GlobalOffset + i] = s_LightIndices[i];
	}
}
